# Copy to .env and adjust. Never commit .env.
DATABASE_URL=pglite://local
# With Docker running instead: DATABASE_URL=postgres://savora:savora@localhost:5433/savora
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Development helpers
SEED_DEMO=1
# Google sign-in turns on when both are set (Google Cloud > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Uploaded dish photos. Empty keeps them in ~/.savora/media (outside OneDrive).
MEDIA_DIR=

# Who may pass the visitor address to the API (x-forwarded-for). Default: this machine and private
# networks, where the web app runs. Never set it to true on a public address.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Billing (manual for now). Staff emails can confirm payments at /en/staff; bank details appear on
# the billing screen once filled in. Leave them empty to tell owners the team will be in touch.
SAVORA_STAFF_EMAILS=
BILLING_BANK_NAME=
BILLING_ACCOUNT_NAME=
BILLING_IBAN=
BILLING_CONTACT_PHONE=
