# Production settings for docker-compose.prod.yml. Copy to .env.production (never commit it).

# The public domain, without https:// (e.g. savora.menu). DNS must point at this server first.
DOMAIN=
# Long random strings. Use hex for the database password: it goes inside a postgres:// URL, where
# characters like / + @ : # would break it.
#   POSTGRES_PASSWORD: openssl rand -hex 32
#   SESSION_SECRET:    openssl rand -base64 48
POSTGRES_PASSWORD=
SESSION_SECRET=
# Shown by /api/health so monitors can tell which build runs (e.g. the git commit).
APP_VERSION=

# Email for sign-in links: any SMTP service (Resend, Postmark, Amazon SES, Mailgun...).
# Example: smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Savora <hello@your-domain>

# Savora staff who confirm payments (comma-separated emails).
SAVORA_STAFF_EMAILS=
# How owners pay while billing is manual.
BILLING_BANK_NAME=
BILLING_ACCOUNT_NAME=
BILLING_IBAN=
BILLING_CONTACT_PHONE=
# Shown on the Privacy and Terms pages.
SUPPORT_EMAIL=
# A published menu the landing page links to as a live example (its slug). Empty hides the link.
EXAMPLE_MENU_SLUG=

# Optional features
OPENROUTER_API_KEY=
# The model OpenRouter uses (needs image + PDF input and structured outputs). Empty: anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Map tiles for production (a provider's URL template). Empty uses OpenStreetMap's public tiles.
NEXT_PUBLIC_MAP_TILES=

# Plans: keep true in production. false unlocks every feature for everyone (testing only).
NEXT_PUBLIC_PLANS_ENABLED=true
