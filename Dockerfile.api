# The Savora API. Build from the repository root:
#   docker build -f Dockerfile.api -t savora-api .
# Runs the TypeScript server with tsx (no compile step); migrations run at start-up.

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
# Production dependencies only; sharp installs its Linux build here.
RUN npm ci --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    API_PORT=4000 \
    MEDIA_DIR=/data/media
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages ./packages
COPY apps/api ./apps/api
# Uploaded photos live on a volume, never inside the image.
RUN mkdir -p /data/media && chown -R node:node /data
USER node
WORKDIR /app/apps/api
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD node -e "fetch('http://127.0.0.1:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# node directly (not npm) so `docker stop` reaches the server and it closes the database cleanly.
CMD ["node", "--import", "tsx", "src/server.ts"]
