# The Savora web app (Next.js standalone server). Build from the repository root:
#   docker build -f Dockerfile.web --build-arg NEXT_PUBLIC_MAP_TILES=... -t savora-web .
# NEXT_PUBLIC_* values are baked in at build time; everything else is read at run time.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
RUN npm ci
COPY packages ./packages
COPY apps/web ./apps/web
ARG NEXT_PUBLIC_MAP_TILES=""
ARG NEXT_PUBLIC_PLANS_ENABLED="true"
ENV NEXT_PUBLIC_MAP_TILES=$NEXT_PUBLIC_MAP_TILES \
    NEXT_PUBLIC_PLANS_ENABLED=$NEXT_PUBLIC_PLANS_ENABLED \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @savora/web

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
# The standalone output keeps the monorepo layout: the server is apps/web/server.js.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
