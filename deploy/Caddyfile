# HTTPS for Savora. Caddy gets and renews the certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	# Guests' addresses reach the app (for rate limits and scan counting) via X-Forwarded-For.
	reverse_proxy web:3000
}

# www.savora.menu -> savora.menu
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
